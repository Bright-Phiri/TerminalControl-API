<div style="background-color: #f4f4f4; padding: 20px;">
  <div style="background-color: #ffffff; margin: 50px auto 0 auto; max-width: 600px; padding: 20px; box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1); border-radius: 8px;">
    
    <h1 style="font-size: 24px; color: #333333; text-align: center; font-family: Arial, sans-serif;">
      Your Subscription Expires in <%= pluralize(@days_left, 'day') %>
    </h1>

    <p style="font-size: 16px; color: #333333; font-family: Arial, sans-serif;">
      Dear <%= @taxpayer.name %>,
    </p>

    <p style="font-size: 16px; color: #333333; font-family: Arial, sans-serif;">
      This is a reminder that your subscription is set to expire in <strong><%= pluralize(@days_left, 'day') %></strong>. Please take a moment to renew and ensure uninterrupted access.
    </p>

    <p style="font-size: 16px; color: #333333; font-family: Arial, sans-serif;">
      <strong>Start Date:</strong> <%= @subscription.start_date.strftime('%B %d, %Y') %><br>
      <strong>End Date:</strong> <%= @subscription.end_date.strftime('%B %d, %Y') %>
    </p>

    <p style="font-size: 16px; color: #e74c3c; font-family: Arial, sans-serif;">
      <strong>Note:</strong> To avoid service disruption, please renew before your subscription ends.
    </p>

    <p style="font-size: 16px; color: #333333;">Thank you for being a valued customer!</p>
    <p style="font-size: 16px; color: #333333;">SataTech Team</p>
  </div>
</div>
