<div style="background-color: #f4f4f4; padding: 20px;">
  <div style="background-color: #ffffff; margin: 50px auto 0 auto; max-width: 600px; padding: 20px; box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1); border-radius: 8px;">
    
    <h1 style="font-size: 24px; color: #333333; text-align: center;">Subscription Expiry Reminder</h1>

    <p style="font-size: 16px; color: #333333;">Dear <%= @taxpayer.name %>,</p>

    <p style="font-size: 16px; color: #333333;">This is a reminder that your subscription is about to expire soon.</p>

    <p style="font-size: 16px; color: #333333;"><strong>Start Date:</strong> <%= @subscription.start_date.strftime('%B %d, %Y') %></p>
    <p style="font-size: 16px; color: #333333;"><strong>End Date:</strong> <%= @subscription.end_date.strftime('%B %d, %Y') %></p>

    <p style="font-size: 16px; color: #e74c3c;">
      <strong>Note:</strong> Your subscription will expire in less than 2 weeks. Please renew your subscription to continue enjoying our services.
    </p>

    <p style="font-size: 16px; color: #333333;">Thank you for being a valued customer!</p>

    <p style="font-size: 16px; color: #333333;">Thanks!</p>
    <p style="font-size: 16px; color: #333333;">SataTech Team</p>

  </div>
</div>
