<div style="background-color: #f4f4f4; padding: 20px;">
  <div style="background-color: #ffffff; margin: 50px auto 0 auto; max-width: 600px; padding: 20px; box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1); border-radius: 8px;">
    <h1 style="margin-top: 30px;">Hi <%= @user.user_name %></h1>
    <p>
     You recently requested to reset your account password. Please use the token below to complete the reset process.
    </p>
    <p style="font-size: 16px; line-height: 1.5;">
      <strong>Note:</strong> This token is valid for the next <strong>2 hours</strong> only.
    </p>
    <hr style="height:1px;border:none;color:#f4f4f4;background-color:#f4f4f4;">
    <p style="font-weight: bold; font-size: 18px; text-align: center;">
      <%= @user.reset_password_token %>
    </p>
    <hr style="height:1px;border:none;color:#f4f4f4;background-color:#f4f4f4;">
    <p>Thanks,</p>
    <p style="margin-bottom: 20px;">SataTech Team</p>
  </div>
</div>